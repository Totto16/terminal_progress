{
	"include": ["src/",],
	"compilerOptions": {
		"target": "es2021",
		"module": "commonjs",
		"moduleResolution": "node",
		"lib": ["es2021", "dom"],
		"allowJs": true,
		"outDir": "build",
		"rootDir": "src",
		"strict": true,
		"noImplicitAny": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"strictNullChecks": true,
		"strictFunctionTypes": true,
		"declaration": true
	},
	"rules": {
		"triple-equals": true,
		"curly": true,
		"strict-boolean-expressions": true,
		"no-unnecessary-condition": true
	},
	"ts-node": {
		"files": true
	}
}
